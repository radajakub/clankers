{
  "name": "@radajakub/clankers",
  "version": "3.0.1",
  "description": "Get notified when long-running Node.js tasks finish",
  "license": "MIT",
  "author": "Jakub Rada <dev.jakubrada@icloud.com>",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "clankers": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radajakub/clankers.git",
    "directory": "packages/nodejs"
  },
  "bugs": {
    "url": "https://github.com/radajakub/clankers/issues"
  },
  "keywords": [
    "ntfy",
    "notifications",
    "push-notifications",
    "monitoring",
    "nestjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "smol-toml": "^1.9.0"
  }
}
